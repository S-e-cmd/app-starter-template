{
  "schemaVersion": 1,
  "starter": {
    "schemaVersion": 2,
    "bootstrapTemplateCommitSha": "SET_AT_BOOTSTRAP",
    "bootstrapTemplateRevision": "SET_AT_BOOTSTRAP",
    "currentParentManifestUrl": "https://raw.githubusercontent.com/S-e-cmd/app-starter-template/main/manifest.json"
  },
  "template": {
    "name": "cloudflare-worker",
    "repository": "S-e-cmd/app-starter-template",
    "repositoryUrl": "https://github.com/S-e-cmd/app-starter-template",
    "manifestUrl": "https://raw.githubusercontent.com/S-e-cmd/app-starter-template/main/manifest.json",
    "parentTemplate": "core"
  },
  "responsibilities": {
    "routes": "worker/routes",
    "services": "worker/services",
    "repositories": "worker/repositories"
  },
  "maintenance": {
    "keepEntryPointThin": true,
    "githubActionsByDefault": false,
    "preserveBehaviorOutsideRequestedScope": true
  },
  "publicSafety": {
    "thisFileMayBePublic": true,
    "excludeSecretsInternalUrlsPrivateIdentifiersPersonalDataAndVulnerabilityDetails": true
  }
}
