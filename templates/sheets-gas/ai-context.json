{
  "schemaVersion": 1,
  "starter": {
    "schemaVersion": 2,
    "bootstrapTemplateCommitSha": "SET_AT_BOOTSTRAP",
    "bootstrapTemplateRevision": "SET_AT_BOOTSTRAP",
    "currentParentManifestUrl": "https://raw.githubusercontent.com/S-e-cmd/app-starter-template/main/manifest.json"
  },
  "template": {
    "name": "sheets-gas",
    "repository": "S-e-cmd/app-starter-template",
    "repositoryUrl": "https://github.com/S-e-cmd/app-starter-template",
    "manifestUrl": "https://raw.githubusercontent.com/S-e-cmd/app-starter-template/main/manifest.json",
    "parentTemplate": "core"
  },
  "responsibilities": {
    "entry": "gas/main.gs",
    "config": "gas/config.gs",
    "api": "gas/api.gs",
    "sheets": "gas/sheet-service.gs",
    "utils": "gas/utils.gs"
