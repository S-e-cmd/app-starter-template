{
  "schemaVersion": 1,
  "template": {
    "name": "core",
    "repository": "S-e-cmd/app-starter-template",
    "repositoryUrl": "https://github.com/S-e-cmd/app-starter-template",
    "manifestUrl": "https://raw.githubusercontent.com/S-e-cmd/app-starter-template/main/manifest.json"
  },
  "build": "YYYYMMDD-NN",
  "docs": {
    "architecture": "docs/ARCHITECTURE.md",
    "dataContract": "docs/DATA_CONTRACT.md",
    "uiRules": "docs/UI_RULES.md",
    "projectStatus": "docs/PROJECT_STATUS.md"
  },
  "maintenance": {
    "splitByResponsibility": true,
    "updateDocsWithCode": true,
    "githubActionsByDefault": false
  },
  "handoff": {
    "readLocalContextFirst": true,
    "thenReadParentManifest": true
  }
}
