{
  "schemaVersion": 1,
  "schemaVersionMeaning": "ai-context-document-schema",
  "starter": {
    "schemaVersion": 5,
    "schemaVersionMeaning": "parent-starter-manifest-schema",
    "bootstrapTemplateCommitSha": "SET_AT_BOOTSTRAP",
    "bootstrapTemplateRevision": "SET_AT_BOOTSTRAP",
    "currentParentManifestUrl": "https://raw.githubusercontent.com/S-e-cmd/app-starter-template/main/manifest.json"
  },
  "template": {
    "name": "core",
    "repository": "S-e-cmd/app-starter-template",
    "repositoryUrl": "https://github.com/S-e-cmd/app-starter-template",
    "manifestUrl": "https://raw.githubusercontent.com/S-e-cmd/app-starter-template/main/manifest.json"
  },
  "build": "YYYYMMDD-NN",
  "docs": {
    "architecture": "docs/ARCHITECTURE.md",
    "dataContract": "docs/DATA_CONTRACT.md",
    "uiRules": "docs/UI_RULES.md",
    "projectStatus": "docs/PROJECT_STATUS.md"
  },
  "maintenance": {
    "splitByResponsibility": true,
    "updateDocsWithCode": true,
    "githubActionsByDefault": false,
    "preserveBehaviorOutsideRequestedScope": true
  },
  "publicSafety": {
    "thisFileMayBePublic": true,
    "validateActualValuesBeforePublishing": true,
    "allowedCategories": [
      "public-app-name-and-type",
      "public-repository-reference-when-repository-is-public",
      "public-entrypoint-and-high-level-responsibility-names",
      "public-safe-build-and-template-metadata"
    ],
    "excludedCategories": [
      "secrets-and-credentials",
      "internal-only-urls",
      "private-resource-identifiers",
      "personal-data",
      "private-repository-confidential-information",
      "unfixed-vulnerability-details",
      "operationally-sensitive-internal-information"
    ],
    "doNotCopyRepositoryInternalContextWithoutFiltering": true
  },
  "handoff": {
    "readLocalContextFirst": true,
    "thenReadParentManifest": true,
    "latestParentRulesDoNotByThemselvesJustifyExistingAppRestructure": true
  }
}