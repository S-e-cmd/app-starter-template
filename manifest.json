{
  "schemaVersion": 3,
  "name": "app-starter-template",
  "purpose": "Canonical AI-readable starter source for guiding repository creation, populating newly created application repositories, guiding deployment, non-destructive existing-app alignment, post-launch feature changes, high-risk recovery and migration work, and continued maintenance.",
  "defaultTemplate": "core",
  "protocolRouting": {
    "required": true,
    "protocol": "docs/PROTOCOL_ROUTING_RULES.md",
    "interpretationCases": "docs/POLICY_INTERPRETATION_CASES.md",
    "selectPrimaryModeByCurrentUserIntent": true,
    "repositoryOrPublicUrlPresenceDoesNotSelectMaintenanceMode": true,
    "highRiskProtocolsOverrideOnlyTheAffectedPart": true,
    "priorityOrder": [
      "security-containment-or-incident-recovery",
      "data-protection-or-migration",
      "environment-recovery-or-change",
      "feature-change",
      "existing-app-alignment",
      "cleanup-deletion"
    ],
    "dependencyUpdatePriorityIsContextual": true,
    "instruction": "Choose the primary protocol from the user's current work goal. Apply high-risk protocols only to the affected part and preserve the original task goal unless safety requires holding that affected part."
  },
  "scopePolicy": {
    "categories": ["direct-change", "required-propagation", "out-of-scope"],
    "directChangeDefinition": "A function, behavior, UI, data flow, or setting the user specifically asked to change.",
    "requiredPropagationDefinition": "An internal change that is unavoidable to make the direct change work or to prevent a concrete regression, compatibility break, data-loss risk, or deployment failure caused by that direct change.",
    "outOfScopeDefinition": "A change that may be beneficial but is not required to satisfy the current task.",
    "requiredPropagationEvidence": {
      "defaultMinimum": "confirmed",
      "inferredAllowedOnlyWhen": [
        "multiple-independent-relevant-evidence-sources",
        "direct-causal-link-to-direct-change",
        "reversible",
        "non-destructive",
        "not-production-mutation"
      ],
      "unknownMayNotBeRequiredPropagation": true,
      "productionOrDestructivePropagationRequiresConfirmedEvidence": true
    },
    "insufficientReasonsForScopeExpansion": [
      "it-could-be-improved",
      "it-is-related",
      "it-is-in-the-same-file",
      "the-file-is-long",
      "best-practice-differs",
      "newer-technology-exists",
      "template-conformance",
      "aesthetic-code-cleanup",
      "unverified-hypothetical-future-risk"
    ],
    "minimalMeans": "Only the responsibilities, contracts, and UI areas required to satisfy the user's requested outcome, not the fewest lines changed.",
    "scopeExpansionClassifications": ["required-propagation", "recommended-improvement", "unrelated-issue"],
    "onlyRequiredPropagationMayProceedAutomatically": true
  },
  "evidencePolicy": {
    "states": ["confirmed", "inferred", "unknown"],
    "doNotAssertWithoutEvidence": ["unused", "unnecessary", "broken", "root-cause", "working", "compatible", "safe"],
    "acceptableEvidenceExamples": ["code-reference", "runtime-result", "log", "actual-setting", "history", "user-confirmation"],
    "namingOrAppearanceAloneIsNotEvidence": true,
    "unverifiedExternalConsumerMeansUsageUnknown": true,
    "usageUnknownPublicContractMustNotBeDeleted": true,
    "unknownMustNotBePromotedToConfirmedForConvenienceOrSafety": true,
    "evidenceStateCarriesIntoScopeAuthorizationRollbackAndContainment": true
  },
  "rulePrecedence": {
    "normalSpecificationOrder": [
      "current-explicit-user-instruction",
      "current-app-specific-contracts-and-ui-rules",
      "verified-runtime-and-current-implementation",
      "parent-template-general-rules",
      "readme-and-older-documentation",
      "inference"
    ],
    "normalPrecedenceDoesNotOverrideSafetyStops": true,
    "normalPrecedenceDoesNotGrantDestructiveAuthorization": true,
    "documentationRuntimeConflictMustBeRecordedAsMismatch": true,
    "doNotSilentlyRewriteEitherSideOfAMismatch": true,
    "unrelatedMismatchDoesNotStopInScopeWork": true,
    "mismatchBlocksOnlyAffectedDecisionWhenNeededForContractOrSafety": true
  },
  "productionMutationPolicy": {
    "enabled": true,
    "toolCapabilityDoesNotEqualUserAuthorization": true,
    "authorizationStates": ["not-authorized", "authorized-for-this-operation", "already-approved-in-current-task"],
    "authorizationFingerprintFields": ["environment", "resource", "operation-type", "target-scope"],
    "inheritAuthorizationOnlyWhenFingerprintMatches": true,
    "anyFingerprintExpansionRequiresNewAuthorization": true,
    "broadMaintenanceRequestIsNotDestructiveAuthorization": true,
    "operations": [
      "production-data-delete-rewrite-import-or-bulk-create",
      "production-schema-migration-or-destructive-change",
      "production-sheet-structure-or-bulk-data-change",
      "production-secret-variable-binding-change",
      "production-branch-deployment-or-provider-setting-change",
      "project-worker-delete-rename-or-behavior-changing-create",
      "public-url-or-custom-domain-change",
      "breaking-production-api-change",
      "production-auth-or-storage-backend-switch",
      "production-permission-role-acl-or-access-control-change",
      "production-cron-trigger-scheduled-job-or-consumer-change",
      "new-production-resource-that-switches-existing-binding-routing-storage-or-target"
    ],
    "irreversibleOrHardToRecoverRequiresOperationSpecificAuthorization": true,
    "requireImpactAndRecoveryPlanBeforeExecution": true
  },
  "securityContainmentPolicy": {
    "unknownLeakDoesNotAuthorizeCredentialMutation": true,
    "readOnlyEvidenceCollectionFirstWhenUnknown": true,
    "confirmedOrDirectExposureEvidenceRequiredForEmergencyContainmentCandidate": true,
    "toolCapabilityDoesNotGrantContainmentAuthorization": true,
    "explicitContainRevokeDisableInstructionMayAuthorizeOnlyNamedOrClearlyScopedTarget": true,
    "preauthorizedRunbookMayAuthorizeOnlyItsDefinedResourceOperationAndScope": true,
    "containmentDoesNotAuthorizePermanentUnrelatedChanges": true
  },
  "productionDataTestPolicy": {
    "priority": ["read-only", "copy-snapshot-staging", "new-isolated-test-record", "modify-existing-production-data"],
    "modifyingExistingProductionDataRequiresExplicitAuthorization": true,
    "doNotMixUnmarkedTestDataIntoProduction": true
  },
  "backupPolicy": {
    "separateBackupTypes": ["code", "schema", "actual-data", "environment-settings"],
    "gitHistoryDoesNotCountAsActualDataBackup": true,
    "recordApplicableRecoverySourceBeforeHighRiskMutation": true
  },
  "rollbackPolicy": {
    "evaluateBeforeRollback": [
      "code-data-schema-compatibility",
      "environment-compatibility",
      "post-migration-data-impact",
      "normal-changes-that-would-be-lost",
      "actual-restore-target-exists",
      "external-api-current-compatibility"
    ],
    "rollForwardAllowedWhenRollbackIsMoreDangerous": true,
    "preferHistoryPreservingRollback": true,
    "avoidForcePushAndHistoryRewriteByDefault": true,
    "lastKnownGoodAxes": ["code", "deployment", "environment", "data-schema", "external-api-compatibility"],
    "oneLimitedFixMeansOneDeployedAndVerifiedCycle": true
  },
  "verificationPolicy": {
    "itemStates": ["verified", "blocked", "not-applicable"],
    "blockedRequiresReasonAlternativeAndResidualRisk": true,
    "blockedOrUnknownDoesNotAutomaticallyStopUnrelatedInScopeWork": true,
    "blockOnlyAffectedDecisionWhenNeededForSuccessSafetyOrAuthorization": true,
    "overallStates": ["complete", "work-complete-verification-pending", "incomplete"],
    "components": ["implementation", "deployment", "verification", "documentation"],
    "componentStates": ["complete", "pending", "not-applicable"],
    "commitDeployOrHttpSuccessAloneIsNotFunctionalSuccess": true,
    "purposeStateMustBeVerified": true
  },
  "buildNumberPolicy": {
    "format": "YYYYMMDD-NN",
    "requiredWhen": [
      "production-executable-code-changes",
      "production-css-or-ui-asset-changes",
      "runtime-consumed-static-data-or-config-changes-user-visible-behavior",
      "production-internal-api-code-changes-response-side-effect-or-contract-behavior",
      "rollback-or-rollforward-changes-published-artifact"
    ],
    "notRequiredByDefaultFor": [
      "docs-only",
      "readme-only",
      "parent-template-explanation-only",
      "runtime-neutral-review-record-only",
      "environment-only-secret-or-permission-change-without-artifact-or-user-behavior-change"
    ],
    "deployedTimestampOrIrrelevantAssetChangeAloneDoesNotRequireBuild": true,
    "appSpecificVersionPolicyTakesPrecedenceWhenExplicit": true,
    "doNotReuseOldBuildNumberForNewPublishedContent": true
  },
  "generatedFilesPolicy": {
    "preferEditingSourceOverDerivedOutput": true,
    "doNotHandEditDerivedOutputWhenSourceExists": true,
    "documentReasonIfDerivedOutputIsCanonical": true
  },
  "fallbackPolicy": {
    "noSilentFallback": true,
    "existingDefinedFallbackMayBeUsed": true,
    "doNotSwitchStorageAuthApiOrDeploymentModeSilently": true
  },
  "concurrencyPolicy": {
    "doNotOverwriteOnShaConflict": true,
    "refetchAndReapplyOwnDiffOnConflict": true,
    "doNotRemoveConcurrentChangesWithoutExplicitReason": true,
    "recheckImportantFileStateBeforeWriteAfterLongRunningWork": true
  },
  "publicContextPolicy": {
    "publicAiContextMustBePublicSafe": true,
    "validateFieldValuesNotOnlyFieldNames": true,
    "exclude": [
      "secrets-and-credentials",
      "internal-only-urls",
      "private-resource-identifiers",
      "personal-data",
      "private-repository-confidential-information",
      "unfixed-vulnerability-details",
      "operationally-sensitive-internal-information"
    ],
    "repositoryInternalProjectStatusMayContainMoreDetail": true,
    "doNotCopyRepositoryInternalContextIntoPublicContextWithoutFiltering": true
  },
  "templateDriftPolicy": {
    "generatedAppMustRecordStarterSchemaVersion": true,
    "generatedAppMustRecordBootstrapTemplateCommitSha": true,
    "generatedAppMustRecordBootstrapTemplateRevision": true,
    "generatedAppMustRecordCurrentParentManifestUrl": true,
    "latestParentRulesMayInformSafety": true,
    "latestParentRulesMustNotByThemselvesJustifyExistingAppRestructure": true
  },
  "creationFlow": {
    "required": true,
    "protocol": "docs/CREATE_AND_DEPLOY_FLOW.md",
    "guideRepositorySettingsBeforeCreation": true,
    "populateRepositoryAfterUrlProvided": true,
    "guideDeploymentAfterImplementation": true,
    "cloudflareSettingsMustBeDerivedFromActualRepository": true,
    "existingSettingsTakePrecedence": true,
    "fixedConfigurationValuesByDefault": false,
    "presentConcreteSettingsToUser": true,
    "markUnusedFieldsExplicitly": true,
    "userChoosesTemplate": false,
    "doNotGuessHighCostUnknowns": ["visibility", "authentication", "persistent-storage", "personal-data-storage", "paid-service-use", "external-exposure", "retention-policy"]
  },
  "existingAppMode": {
    "enabled": true,
    "protocol": "docs/EXISTING_APP_ALIGNMENT_PROTOCOL.md",
    "batchCompletionGuide": "docs/BATCH_COMPLETION_CHOICES.md",
    "selectByUserIntent": true,
    "repositoryAndPublicUrlAreContextNotTrigger": true,
    "templateConformanceIsNotGoal": true,
    "preserveExistingArchitectureByDefault": true,
    "doNotRestructureToMatchTemplate": true,
    "templateUsedAsGuidanceOnly": true,
    "preserveBehaviorOutsideRequestedScope": true,
    "preserveExistingDataContracts": true,
    "preserveExistingDeployment": true,
    "workInSafeBatches": true,
    "completeCheckChangeRegressionRecordPerBatch": true,
    "doNotStopAtCapabilityLimitations": true,
    "continueWithAvailableChecksFixesAndAlternatives": true,
    "requireMaintenanceNeedAssessmentAfterEachBatch": true,
    "maintenanceNeedLevels": ["high", "medium", "low", "hold"],
    "maintenanceNeedMustIgnoreTemplateConformance": true,
    "maintenanceNeedFactors": [
      "data-loss-or-compatibility-risk",
      "deployment-or-major-feature-failure-risk",
      "change-impact-radius",
      "responsibility-mixing-change-risk",
      "unverified-critical-integrations-or-storage",
      "handoff-difficulty"
    ],
    "batchChoicePolicy": "conditional",
    "mayAutoContinueWhenUserAlreadyAuthorizedContinuation": true,
    "mustPauseForChoiceWhen": [
      "scope-expands-beyond-current-task",
      "new-production-mutation-needs-authorization",
      "high-risk-protocol-needs-operation-specific-authorization",
      "materially-different-implementation-options-require-user-choice",
      "user-requested-per-batch-choice"
    ],
    "batchCompletionChoices": ["continue", "finish-for-now", "prioritize-another-area"],
    "requireChoiceDescriptionsWhenChoiceIsPresented": true,
    "markRecommendedChoice": true,
    "continueChoiceMustNameNextBatch": true,
    "prioritizeAnotherAreaMustExplainWhatUserCanSpecify": true,
    "instruction": "Use existing-app alignment when the user's current goal is whole-app stabilization, organization, responsibility cleanup, maintainability improvement, or handoff preparation. Do not select this mode merely because an existing repository and public URL were provided. If the user already instructed the AI to continue through the roadmap, finish the stated scope, or process remaining stabilization work, continue through safe in-scope batches without forcing a choice after every batch. Pause only the affected part when scope expands, a new destructive/production mutation needs authorization, a high-risk operation requires specific approval, or the user must choose between materially different directions."
  },
  "featureChange": {
    "enabled": true,
    "protocol": "docs/FEATURE_CHANGE_PROTOCOL.md",
    "useForPostLaunchFeatureAdditionsAndSmallChanges": true,
    "inspectAffectedScopeBeforeChanging": true,
    "reuseExistingComponentsWhenAppropriate": true,
    "requestedScopeMayChangeExistingBehavior": true,
    "preserveBehaviorOutsideRequestedScope": true,
    "preserveDataCompatibility": true,
    "avoidUnrelatedLargeRefactors": true,
    "splitNewResponsibilitiesWhenUseful": true,
    "regressionCheckAffectedScope": true,
    "updateHandoffDocsWithCode": true,
    "verifyPublishedBuildWhenDeploymentChanges": true
  },
  "highRiskOperations": {
    "enabled": true,
    "normalFeatureProtocolMustYieldWhenMatched": true,
    "incidentRecovery": {
      "protocol": "docs/INCIDENT_RECOVERY_PROTOCOL.md",
      "doNotStackSpeculativeFixesOnBrokenState": true,
      "separateRecoveryFromPermanentFix": true,
      "rollbackRequiresSafetyEvaluation": true,
      "rollForwardAllowedWhenSafer": true
    },
    "dataMigration": {
      "protocol": "docs/DATA_MIGRATION_PROTOCOL.md",
      "preserveBackwardCompatibilityByDefault": true,
      "requireRollbackOrRecoveryPlan": true,
      "doNotDeleteOldCompatibilityBeforeMigrationCompletionCriteria": true
    },
    "environmentChange": {
      "protocol": "docs/ENVIRONMENT_CHANGE_PROTOCOL.md",
      "inspectActualSettingsBeforeChanging": true,
      "preserveExistingNamesAndDeploymentByDefault": true,
      "requireConcreteUserStepsWhenManualActionIsNeeded": true
    },
    "cleanupDeletion": {
      "protocol": "docs/CLEANUP_DELETION_PROTOCOL.md",
      "unusedLookingIsNotSufficientEvidence": true,
      "checkDynamicAndExternalReferences": true,
      "deleteLateAndInSmallBatches": true,
      "contractBoundaryRenameIsBreakingRegardlessOfCount": true
    },
    "dependencyUpdate": {
      "protocol": "docs/DEPENDENCY_UPDATE_PROTOCOL.md",
      "doNotMixMajorUpdatesWithFeatureWork": true,
      "requireCompatibilityAndRollbackCheck": true,
      "doNotUpgradeOnlyForConformance": true,
      "checkDirectTransitiveAndLockfileDiffs": true,
      "securityUpdatesMayOverrideNormalBatchSeparation": true
    }
  },
  "bootstrap": {
    "required": true,
    "protocol": "docs/BOOTSTRAP_PROTOCOL.md",
    "mustCompleteBeforeApplicationImplementation": true,
    "newApplicationTargetWithoutAiContextIsUnbootstrapped": true,
    "existingApplicationWithoutAiContextMustNotBeRebuiltAsNew": true,
    "existingStartedCodeMustNotBeRefactoredJustToBootstrap": true,
    "requiredFiles": [
      "ai-context.json",
      "llms.txt",
      "docs/ARCHITECTURE.md",
      "docs/DATA_CONTRACT.md",
      "docs/UI_RULES.md",
      "docs/PROJECT_STATUS.md"
    ],
    "completionCheck": "docs/TEMPLATE_CHECKLIST.md"
  },
  "deploymentPolicy": {
    "mode": "ai-populate-repository",
    "humanTemplateCopyRequired": false,
    "githubUseThisTemplateRequired": false,
    "inspectActualRepositoryBeforeConcreteDeploymentAdvice": true,
    "preserveExistingDeploymentNamesAndBindingsByDefault": true
  },
  "selectionPolicy": {
    "userSelectionRequired": false,
    "instruction": "Infer the required template composition from the application requirements. Always start with core and add only the extensions actually needed for new applications. Existing applications must not be restructured merely to match this composition.",
    "rules": {
      "core": "Always apply to new applications.",
      "cloudflare-worker": "Add to new applications when server-side HTTP/API processing or Cloudflare Worker functionality is required.",
      "d1": "Add to new applications when Cloudflare D1 persistence is required. Also apply cloudflare-worker.",
      "sheets-gas": "Add to new applications when Google Sheets or Google Apps Script integration is required."
    }
  },
  "templates": {
    "core": {
      "path": "templates/core",
      "aiContext": "templates/core/ai-context.json"
    },
    "cloudflare-worker": {
      "path": "templates/cloudflare-worker",
      "aiContext": "templates/cloudflare-worker/ai-context.json",
      "extends": ["core"]
    },
    "d1": {
      "path": "templates/d1",
      "aiContext": "templates/d1/ai-context.json",
      "extends": ["core", "cloudflare-worker"]
    },
    "sheets-gas": {
      "path": "templates/sheets-gas",
      "aiContext": "templates/sheets-gas/ai-context.json",
      "extends": ["core"]
    }
  },
  "rules": {
    "protocolRouting": "docs/PROTOCOL_ROUTING_RULES.md",
    "interpretationCases": "docs/POLICY_INTERPRETATION_CASES.md",
    "creationAndDeployment": "docs/CREATE_AND_DEPLOY_FLOW.md",
    "existingAppAlignment": "docs/EXISTING_APP_ALIGNMENT_PROTOCOL.md",
    "existingAppBatchCompletion": "docs/BATCH_COMPLETION_CHOICES.md",
    "featureChange": "docs/FEATURE_CHANGE_PROTOCOL.md",
    "incidentRecovery": "docs/INCIDENT_RECOVERY_PROTOCOL.md",
    "dataMigration": "docs/DATA_MIGRATION_PROTOCOL.md",
    "environmentChange": "docs/ENVIRONMENT_CHANGE_PROTOCOL.md",
    "cleanupDeletion": "docs/CLEANUP_DELETION_PROTOCOL.md",
    "dependencyUpdate": "docs/DEPENDENCY_UPDATE_PROTOCOL.md",
    "bootstrap": "docs/BOOTSTRAP_PROTOCOL.md",
    "development": "docs/DEVELOPMENT_RULES.md",
    "architecture": "docs/ARCHITECTURE_RULES.md",
    "ui": "docs/UI_RULES.md",
    "data": "docs/DATA_RULES.md",
    "validation": "docs/TEMPLATE_CHECKLIST.md"
  },
  "handoff": {
    "generatedAppMustKeep": [
      "ai-context.json",
      "llms.txt",
      "docs/ARCHITECTURE.md",
      "docs/DATA_CONTRACT.md",
      "docs/UI_RULES.md",
      "docs/PROJECT_STATUS.md"
    ],
    "publicUrlDiscovery": "/ai-context.json",
    "readLocalContextBeforeParentRules": true,
    "publicContextMustFollowPublicContextPolicy": true
  },
  "policies": {
    "splitByResponsibilityFromStart": true,
    "selfDescribingRepository": true,
    "githubActionsByDefault": false,
    "preserveBehaviorOutsideRequestedScope": true,
    "securityIncidentContainmentPrecedesNormalRecovery": true,
    "doNotSilentlyExpandScope": true,
    "doNotSilentlyFallback": true,
    "doNotReportFakeSuccess": true
  }
}