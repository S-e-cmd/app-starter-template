{
  "schemaVersion": 1,
  "name": "app-starter-template",
  "purpose": "Maintainable starter templates for new applications and AI-assisted continuation work.",
  "defaultTemplate": "core",
  "selectionPolicy": {
    "userSelectionRequired": false,
    "instruction": "Infer the required template composition from the application requirements. Always start with core and add only the extensions actually needed.",
    "rules": {
      "core": "Always apply.",
      "cloudflare-worker": "Add when server-side HTTP/API processing or Cloudflare Worker functionality is required.",
      "d1": "Add when Cloudflare D1 persistence is required. Also apply cloudflare-worker.",
      "sheets-gas": "Add when Google Sheets or Google Apps Script integration is required."
    }
  },
  "templates": {
    "core": {
      "path": "templates/core",
      "aiContext": "templates/core/ai-context.json"
    },
    "cloudflare-worker": {
      "path": "templates/cloudflare-worker",
      "aiContext": "templates/cloudflare-worker/ai-context.json",
      "extends": ["core"]
    },
    "d1": {
      "path": "templates/d1",
      "aiContext": "templates/d1/ai-context.json",
      "extends": ["core", "cloudflare-worker"]
    },
    "sheets-gas": {
      "path": "templates/sheets-gas",
      "aiContext": "templates/sheets-gas/ai-context.json",
      "extends": ["core"]
    }
  },
  "rules": {
    "development": "docs/DEVELOPMENT_RULES.md",
    "architecture": "docs/ARCHITECTURE_RULES.md",
    "ui": "docs/UI_RULES.md",
    "data": "docs/DATA_RULES.md",
    "validation": "docs/TEMPLATE_CHECKLIST.md"
  },
  "handoff": {
    "generatedAppMustKeep": [
      "ai-context.json",
      "llms.txt",
      "docs/ARCHITECTURE.md",
      "docs/DATA_CONTRACT.md",
      "docs/UI_RULES.md",
      "docs/PROJECT_STATUS.md"
    ],
    "publicUrlDiscovery": "/ai-context.json",
    "readLocalContextBeforeParentRules": true
  },
  "policies": {
    "splitByResponsibilityFromStart": true,
    "selfDescribingRepository": true,
    "githubActionsByDefault": false,
    "preserveExistingBehavior": true
  }
}
